        available: true
    },
    {
        id: 2,
        name: "Honda Civic",
        type: "Car",
        price: 2500,
        available: true
    },
    {
        id: 3,
        name: "Nissan Terra",
        type: "SUV",
        price: 3500,
        available: true
    },
    {
        id: 4,
        name: "Ford Ranger",
        type: "Pickup",
        price: 3000,
        available: true
    },
    {
        id: 5,
        name: "Mitsubishi Xpander",
        type: "MPV",
