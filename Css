* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

:root {
    --navy: #294768;
    --blue: #008fe5;
    --background: #f2f3f8;
    --white: #ffffff;
    --text: #202633;
}

body {
    background: var(--background);
    color: var(--text);
    min-height: 100vh;
}

button, input, select {
    font: inherit;
}

button {
    cursor: pointer;
    border: none;
}

.hidden {
    display: none !important;
}

/* LOGIN PAGE */

#loginPage {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 25px;
}

.login-card {
    background: white;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 900px;
    width: 100%;
    min-height: 480px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 30px #172b441a;
}

.login-banner {
    background: #06477d;
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 30px;
}

.brand {
    font-size: 27px;
    font-weight: bold;
    letter-spacing: 2px;
}

.login-banner p {
    margin-top: 12px;
    line-height: 1.6;
}

.login-form {
    padding: 45px 35px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.login-form h2 {
    font-size: 23px;
    margin-bottom: 8px;
}

.subtitle {
    color: #7c8491;
    font-size: 12px;
    margin-bottom: 28px;
}

.field {
    margin-bottom: 17px;
}

.field label {
    display: block;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 8px;
}

.field input,
.field select {
    width: 100%;
    padding: 11px;
    border: 1px solid #d9dce3;
    border-radius: 5px;
    outline-color: var(--blue);
    background: white;
}

.primary-btn {
    padding: 11px 18px;
    background: var(--blue);
    color: white;
    border-radius: 6px;
    font-size: 12px;
    font-weight: bold;
}

.primary-btn:hover {
    background: #0076c1;
}

.login-form .primary-btn {
    width: 100%;
    background: var(--navy);
}

.switch-text {
    text-align: center;
    font-size: 12px;
    margin-top: 20px;
    color: #747b88;
}

.switch-text a {
    color: var(--blue);
    cursor: pointer;
    font-weight: bold;
}

/* MAIN APPLICATION */

#app {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 205px;
    flex-shrink: 0;
    background: var(--navy);
    color: white;
    padding: 24px 12px;
    display: flex;
    flex-direction: column;
}

.sidebar-brand {
    padding: 0 10px 28px;
}

.sidebar-brand h2 {
    font-size: 21px;
}

.sidebar-brand small {
    font-size: 9px;
    color: #d6e1ed;
}

.nav-btn {
    width: 100%;
    text-align: left;
    color: #e5edf7;
    background: transparent;
    border-radius: 18px;
    padding: 12px 13px;
    margin-bottom: 5px;
    font-size: 12px;
}

.nav-btn:hover,
.nav-btn.active {
    background: var(--blue);
    color: white;
}

.logout {
    margin-top: auto;
    color: white;
    background: transparent;
    text-align: left;
    padding: 14px 12px;
    font-size: 12px;
}

.main {
    flex: 1;
    min-width: 0;
    padding: 24px;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
}

.topbar h2 {
    font-size: 21px;
}

.topbar p {
    color: #858b97;
    font-size: 11px;
    margin-top: 5px;
}

.user {
    background: white;
    border-radius: 25px;
    padding: 10px 14px;
    font-size: 12px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 22px;
}

.stat-card,
.panel {
    background: white;
    border-radius: 10px;
    padding: 18px;
}

.stat-card small {
    color: #7e8591;
    font-size: 11px;
}

.stat-card h2 {
    font-size: 24px;
    margin-top: 12px;
}

.stat-icon {
    float: right;
    font-size: 19px;
}

.panel {
    margin-bottom: 20px;
}

.panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
}

.panel-heading h3 {
    font-size: 15px;
}

.panel-heading button {
    font-size: 11px;
}

.vehicle-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
}

.vehicle-card {
    border: 1px solid #eeeeF2;
    border-radius: 8px;
    overflow: hidden;
    background: white;
}

.vehicle-card img {
    width: 100%;
    height: 100px;
    object-fit: cover;
    background: #eee;
}

.vehicle-info {
    padding: 10px;
}

.vehicle-info h4 {
    font-size: 12px;
    margin-bottom: 7px;
}

.vehicle-info p {
    font-size: 10px;
    color: #858b97;
    margin-bottom: 7px;
}

.status {
    display: inline-block;
    padding: 5px 8px;
    border-radius: 12px;
    background: #d6f8e6;
    color: #16834c;
    font-size: 10px;
}

.status.rented {
    background: #ffe1e1;
    color: #bd3939;
}

.status.maintenance {
    background: #fff0c9;
    color: #966800;
}

/* TABLES */

.table-wrap {
    width: 100%;
    overflow-x: auto;
}

table {
    border-collapse: collapse;
    width: 100%;
    font-size: 12px;
    text-align: left;
}

th,
td {
    padding: 13px 10px;
    border-bottom: 1px solid #eceef2;
    white-space: nowrap;
}

th {
    background: #f7f8fb;
    color: #667080;
    font-size: 11px;
}

td img {
    width: 65px;
    height: 40px;
    object-fit: cover;
    border-radius: 5px;
    vertical-align: middle;
}

.small-btn {
    background: #e5f3ff;
    color: #0077c8;
    border-radius: 5px;
    padding: 7px 10px;
    font-size: 11px;
}

.danger-btn {
    background: #ffeded;
    color: #bd3939;
    border-radius: 5px;
    padding: 7px 10px;
    font-size: 11px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.form-grid .field {
    margin-bottom: 5px;
}

.full {
    grid-column: 1 / -1;
}

.total-box {
    background: #edf6ff;
    border-radius: 8px;
    padding: 17px;
    margin: 18px 0;
}

.total-box h2 {
    color: var(--navy);
    margin-top: 8px;
}

.empty {
    color: #818896;
    text-align: center;
    padding: 25px;
    font-size: 13px;
}

/* RESPONSIVE */

@media (max-width: 900px) {
    .sidebar {
        width: 175px;
    }

    .main {
        padding: 17px;
    }

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .vehicle-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    #app {
        display: block;
    }

    .sidebar {
        width: 100%;
        padding: 12px;
    }

    .sidebar-brand {
        padding: 5px 8px 12px;
    }

    .sidebar nav {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 5px;
    }

    .nav-btn {
        margin: 0;
    }

    .logout {
        margin-top: 10px;
    }

    .main {
        padding: 14px;
    }

    .login-card {
        grid-template-columns: 1fr;
    }

    .login-banner {
        min-height: 190px;
    }

    .login-form {
        padding: 28px 22px;
    }

    .stats {
        gap: 8px;
    }

    .stat-card {
        padding: 13px;
    }

    .vehicle-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .full {
        grid-column: auto;
    }
}
